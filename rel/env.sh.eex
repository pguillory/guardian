#!/bin/sh

# # Sets and enables heart (recommended only in daemon mode)
# case $RELEASE_COMMAND in
#   daemon*)
#     HEART_COMMAND="$RELEASE_ROOT/bin/$RELEASE_NAME $RELEASE_COMMAND"
#     export HEART_COMMAND
#     export ELIXIR_ERL_OPTIONS="-heart"
#     ;;
#   *)
#     ;;
# esac

# # Set the release to load code on demand (interactive) instead of preloading (embedded).
# export RELEASE_MODE=interactive

# Node naming and distribution, in one of three modes:
#
# 1. Fly.io (FLY_PRIVATE_IP set): every machine is guardian@<its private IPv6
#    address> and finds its peers through DNS_CLUSTER_QUERY, by default
#    <app>.internal. The basename is fixed (not Fly's app-plus-image-ref template) so
#    old and new releases stay connected during a rolling deploy.
# 2. A cluster member elsewhere (GUARDIAN_NODE_HOST set): guardian@<that address>.
#    With DNS_CLUSTER_QUERY, the address must be the IP the query resolves to for this
#    node (Cluster.discovery_child_spec/1 checks it at boot).
# 3. A single node (neither set): guardian@localhost, with epmd and distribution
#    listening on loopback only, so `bin/guardian remote` works on the machine itself
#    and nothing else can reach distribution.
#
# Modes 1 and 2 need RELEASE_COOKIE, which must match on every node and grants code
# execution on all of them.
node_host="${GUARDIAN_NODE_HOST:-${FLY_PRIVATE_IP:-}}"
if [ -n "$node_host" ]; then
  if [ -z "${RELEASE_COOKIE:-}" ]; then
    if [ -n "${FLY_PRIVATE_IP:-}" ]; then
      echo "RELEASE_COOKIE must be set (fly secrets set RELEASE_COOKIE=...)" >&2
    else
      echo "RELEASE_COOKIE must be set when GUARDIAN_NODE_HOST is set; use the same secret on every node" >&2
    fi
    exit 1
  fi
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="guardian@${node_host}"
  # An IPv6 address needs IPv6 distribution.
  case "$node_host" in
    *:*) export ERL_AFLAGS="${ERL_AFLAGS:+$ERL_AFLAGS }-proto_dist inet6_tcp" ;;
  esac
  if [ -z "${DNS_CLUSTER_QUERY:-}" ] && [ -n "${FLY_PRIVATE_IP:-}" ] && [ -n "${FLY_APP_NAME:-}" ]; then
    export DNS_CLUSTER_QUERY="${FLY_APP_NAME}.internal"
  fi
else
  export RELEASE_DISTRIBUTION=sname
  export RELEASE_NODE=guardian@localhost
  export ERL_EPMD_ADDRESS=127.0.0.1
  export ERL_AFLAGS="${ERL_AFLAGS:+$ERL_AFLAGS }-kernel inet_dist_use_interface {127,0,0,1}"
fi
unset node_host

# GUARDIAN_DIST_PORT pins the server's distribution port (besides epmd's 4369), for
# firewalls. Only the server binds it: `remote` and `rpc` start client nodes that would
# otherwise try to listen on the same port.
if [ -n "${GUARDIAN_DIST_PORT:-}" ]; then
  case "$GUARDIAN_DIST_PORT" in
    *[!0-9]* | ??????*)
      echo "GUARDIAN_DIST_PORT must be a port number from 1 to 65535" >&2
      exit 1
      ;;
  esac
  if [ "$GUARDIAN_DIST_PORT" -lt 1 ] || [ "$GUARDIAN_DIST_PORT" -gt 65535 ]; then
    echo "GUARDIAN_DIST_PORT must be a port number from 1 to 65535" >&2
    exit 1
  fi
  case "${RELEASE_COMMAND:-}" in
    start | start_iex | daemon | daemon_iex)
      export ERL_AFLAGS="${ERL_AFLAGS:+$ERL_AFLAGS }-kernel inet_dist_listen_min $GUARDIAN_DIST_PORT inet_dist_listen_max $GUARDIAN_DIST_PORT"
      ;;
  esac
fi
